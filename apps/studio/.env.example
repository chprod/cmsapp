HOST=0.0.0.0
PORT=1337
# Genera valores propios: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=cambia-esto-1,cambia-esto-2
API_TOKEN_SALT=cambia-esto
ADMIN_JWT_SECRET=cambia-esto
TRANSFER_TOKEN_SALT=cambia-esto
JWT_SECRET=cambia-esto
ENCRYPTION_KEY=cambia-esto

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Experience Resolver: Strapi le avisa cada publicación para invalidar caché (§8.3)
RESOLVER_WEBHOOK_URL=http://localhost:4000/v1/webhooks/strapi
RESOLVER_WEBHOOK_SECRET=dev-secret

# Carga registro de componentes, audiencias, segmentos y experiencias de ejemplo si la base está vacía
SEED_ON_BOOT=true
